// Copy to Config/Secrets.xcconfig (ignored by git) and fill in what you have.
// In CI the workflow writes this file from GitHub secrets.
//
// xcconfig treats "//" as a comment, so write URLs as https:/$()/host/path.

OX_TEAM_ID = ABCDE12345
OX_BUNDLE_ID = com.yourname.oxydemap

// Your deployed backend (docs/BACKEND.md). The TomTom key lives on the server, never here.
// OX_BACKEND_BASE_URL = https:/$()/oxyde-backend.example.com/

// Optional vector engine (needs the MapLibre package, docs/PROVIDERS.md). Only use
// client-side keys that are restricted to your bundle ID.
// OX_VECTOR_TILEJSON_URL = https:/$()/api.maptiler.com/tiles/v3-openmaptiles/tiles.json?key=YOUR_PUBLIC_KEY
// OX_VECTOR_GLYPHS_URL = https:/$()/api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=YOUR_PUBLIC_KEY
// OX_VECTOR_FONT_STACK = Noto Sans Regular
// OX_VECTOR_IMAGERY_TILE_URL = https:/$()/api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_PUBLIC_KEY
// OX_VECTOR_TERRAIN_TILEJSON_URL = https:/$()/api.maptiler.com/tiles/terrain-rgb-v2/tiles.json?key=YOUR_PUBLIC_KEY
// OX_VECTOR_ATTRIBUTION = © MapTiler © OpenStreetMap contributors

// After Apple grants CarPlay navigation:
// OX_ENTITLEMENTS = OxydeMap/Resources/OxydeMap-Full.entitlements
